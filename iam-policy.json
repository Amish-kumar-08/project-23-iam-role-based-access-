
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListProjectBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::PROJECT_BUCKET_NAME"
    },
    {
      "Sid": "AllowReadProjectObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::PROJECT_BUCKET_NAME/*"
    }
  ]
}

